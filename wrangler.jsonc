{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "justingriffiths-site",
  // JG Personal. Pinned because the Cloudflare login sees three accounts.
  "account_id": "6d4a918dd966be7c05f23b2e154b3d1d",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "build": { "command": "node build.mjs" },
  // /learn/... is forwarded to the Blossom Tutoring course Worker (see src/worker.js).
  "services": [{ "binding": "BLOSSOM", "service": "blossom" }],
  // Deploying this config claims justingriffiths.com and www (Workers custom domains,
  // which also create the DNS records). Do not deploy it until justingriffiths.info is
  // verified live and the apex's old tunnel CNAME has been freed. See README, Cutover.
  "routes": [
    { "pattern": "justingriffiths.com", "custom_domain": true },
    { "pattern": "www.justingriffiths.com", "custom_domain": true }
  ],
  // /fleet/* checks the Cloudflare Access token. Both are public identifiers, not secrets; empty
  // means /fleet/ answers 404 to everyone. Team = the JG Personal Zero Trust org (tempoadv);
  // AUD = Access app "Fleet" (justingriffiths.com/fleet, id 8d4de6fd…), created 2026-11-07.
  "vars": { "ACCESS_TEAM_DOMAIN": "tempoadv.cloudflareaccess.com", "ACCESS_AUD": "e6bb94773c8ffcc302b96784de10095657451b7f3dbcf344217e8baa8ec7869b" },
  // Live fleet state: /fleet/state.json reads key "state.json" from this KV binding (the mini writes it,
  // bin/fleet-kv.sh). Namespace "fleet-state" in JG Personal, created 2026-11-07 (site#43). Takes effect on deploy;
  // until the pusher writes a key, /fleet/state.json answers 404.
  "kv_namespaces": [{ "binding": "FLEET_KV", "id": "7683fca9f60d446cb3799db66178df15" }],
  "workers_dev": true
}
