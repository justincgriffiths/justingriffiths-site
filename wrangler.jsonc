{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "justingriffiths-site",
  // JG Personal. Pinned because the Cloudflare login sees three accounts.
  "account_id": "6d4a918dd966be7c05f23b2e154b3d1d",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "build": { "command": "node build.mjs" },
  // /learn/... is forwarded to the Blossom Tutoring course Worker (see src/worker.js).
  "services": [{ "binding": "BLOSSOM", "service": "blossom" }],
  // Deploying this config claims justingriffiths.com and www (Workers custom domains,
  // which also create the DNS records). Do not deploy it until justingriffiths.info is
  // verified live and the apex's old tunnel CNAME has been freed. See README, Cutover.
  "routes": [
    { "pattern": "justingriffiths.com", "custom_domain": true },
    { "pattern": "www.justingriffiths.com", "custom_domain": true }
  ],
  "workers_dev": true
}
