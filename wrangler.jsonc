{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "justingriffiths-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "build": { "command": "node build.mjs" },
  // Custom domains take over the apex and www. Deploy only after the research
  // site answers on justingriffiths.info (see README, "Cutover").
  "routes": [
    { "pattern": "justingriffiths.com", "custom_domain": true },
    { "pattern": "www.justingriffiths.com", "custom_domain": true }
  ]
}
