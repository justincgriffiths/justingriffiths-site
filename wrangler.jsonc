{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "justingriffiths-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "build": { "command": "node build.mjs" },
  // Deploying this config claims justingriffiths.com and www (Workers custom domains,
  // which also create the DNS records). Do not deploy it until justingriffiths.info is
  // verified live and the apex's old tunnel CNAME has been freed. See README, Cutover.
  "routes": [
    { "pattern": "justingriffiths.com", "custom_domain": true },
    { "pattern": "www.justingriffiths.com", "custom_domain": true }
  ],
  "workers_dev": true
}
