{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "justingriffiths-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "build": { "command": "node build.mjs" },
  // No custom domains yet, so a deploy lands on workers.dev only and can't take
  // over the live site. At cutover (README) add routes for justingriffiths.com and
  // www.justingriffiths.com with "custom_domain": true.
  "workers_dev": true
}
